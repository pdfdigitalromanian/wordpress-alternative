# apps/web environment contract.
# Copy to .env.local for local development. Never commit the real file
# (see repo .gitignore). Which project this points at must always be
# obvious in the running app; never fall back silently from local to prod.

# --- Public browser configuration -------------------------------------
# Exposed to client code via the VITE_ prefix. Only non-secret values here.
# Local dev: obtain these from `supabase start` output after `supabase init`
# in supabase/ (anon/publishable key + local API URL, typically
# http://127.0.0.1:54321). Do NOT point local dev at the hosted project
# below unless you are deliberately testing against it.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<LOCAL_ANON_KEY_FROM_SUPABASE_START>

# --- Server-only configuration ------------------------------------------
# NEVER prefix these with VITE_. They must not reach the browser bundle.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<LOCAL_SERVICE_ROLE_OR_SECRET_KEY_FROM_SUPABASE_START>

# Root key for authenticated encryption of per-site integration secrets.
# Generate locally, e.g.: openssl rand -base64 32
# Keep outside the database. Rotate procedure: docs/setup.md.
INTEGRATION_ENCRYPTION_KEY=<GENERATE_LOCALLY_32_BYTES_BASE64>

# Session/cookie signing secret, separate from the encryption key above.
# Generate locally, e.g.: openssl rand -base64 32
SESSION_SECRET=<GENERATE_LOCALLY_32_BYTES_BASE64>

# --- Optional commerce (Medusa) bootstrap for local dev ------------------
# This is a single local/dev connection for bootstrapping only. Production
# commerce connections are site-scoped and stored encrypted through the
# Integrations layer (see docs/architecture.md) — this variable must never
# be used to make all sites share one backend.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=<GENERATED_IN_THE_LOCAL_MEDUSA_INSTALLATION>
MEDUSA_ADMIN_API_KEY=<SERVER_ONLY_KEY_FOR_THE_LOCAL_INSTALLATION>

# --- Hosted CMS project reference (for later, authorized use only) -------
# The owner-provisioned hosted Supabase project. Do not point local
# development at this project. Used only for deliberate, authorized
# deploys/migrations per docs/setup.md.
# VITE_SUPABASE_URL=https://nsfcmwlbippjjlpvjoyd.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<COPY_PUBLIC_KEY_FROM_SUPABASE_DASHBOARD>
# SUPABASE_URL=https://nsfcmwlbippjjlpvjoyd.supabase.co
# SUPABASE_SECRET_KEY=<SERVER_ONLY_SUPABASE_SECRET_KEY_FROM_DASHBOARD>
