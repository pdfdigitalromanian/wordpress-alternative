{
  "name": "@digital-romanian/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "find app/lib -name '*.test.ts' | xargs node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "test:features": "pnpm build && playwright test --config playwright.features.config.ts"
  },
  "dependencies": {
    "@puckeditor/core": "^0.23.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/react-router": "^1.3.6",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "undici": "^8.10.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
