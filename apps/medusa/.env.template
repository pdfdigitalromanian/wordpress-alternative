# apps/medusa environment contract. Copy to .env for local development.
# Never commit the real .env (see repo .gitignore). Production/staging use
# their own separate values on the hosting platform, never these.

DATABASE_URL=<MEDUSA_POSTGRES_CONNECTION_STRING_NOT_A_SUPABASE_HTTPS_URL>
REDIS_URL=<REDIS_CONNECTION_STRING>
JWT_SECRET=<SEPARATE_RANDOM_SECRET>
COOKIE_SECRET=<SEPARATE_RANDOM_SECRET>
AUTH_MFA_ENCRYPTION_KEY=<SEPARATE_RANDOM_SECRET>

# Explicit allowed origins. No wildcards in production.
STORE_CORS=http://localhost:8000,http://localhost:5173
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# "shared" for local dev only. Production deploys use "server" and "worker"
# processes separately (see docs/architecture.md); disable native Admin in
# the worker process with DISABLE_MEDUSA_ADMIN=true.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
PORT=9000

# Document additional variables required by installed payment, email, file,
# caching, locking and workflow providers here as they are added; do not
# invent SDK variable names ahead of actually installing an adapter.
