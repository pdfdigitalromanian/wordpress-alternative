{
  "name": "digital-romanian-cms",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @digital-romanian/web dev",
    "dev:web": "pnpm --filter @digital-romanian/web dev",
    "dev:medusa": "pnpm --filter @digital-romanian/medusa dev",
    "build:web": "pnpm --filter @digital-romanian/web build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test:rls": "node --env-file=apps/web/.env.local supabase/tests/workspace-isolation.mjs",
    "test:publish": "node --env-file=apps/web/.env.local supabase/tests/publish-rollback.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
